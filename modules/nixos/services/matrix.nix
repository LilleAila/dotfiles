# NOTE: users not defined declaratively
# i created my user `olai` using the following command:
# matrix-synapse-register_new_matrix_user

{ lib, self, ... }:
{
  flake.modules.nixos.matrix =
    {
      pkgs,
      inputs,
      config,
      user,
      ...
    }:
    let
      cfg = config.settings.matrix;

      mkBridgeSettings = id: {
        homeserver = {
          address = "http://localhost:8008";
          domain = "olai.dev";
        };
        appservice = {
          inherit id;
          public.enabled = false;
        };
        double_puppet = {
          secrets = {
            "olai.dev" = "as_token:${self.secrets.matrix.as_token}";
          };
        };
        bridge = {
          create_portals = true;
          backfill = {
            enabled = true;
          };
          permissions = {
            # "*" = "relay";
            "@olai:olai.dev" = "admin";
          };
        };
      };
    in
    {
      options.settings.matrix.enable = lib.mkEnableOption "matrix";

      config = lib.mkIf cfg.enable {
        # Bridges
        services.mautrix-signal = {
          enable = true;
          registerToSynapse = true;
          settings = mkBridgeSettings "signal";
        };

        # using the // operator got too complex so hard-coding here.
        services.mautrix-discord = {
          # For some reason, the discord bridge didn't automatically use the double puppet config
          # so instead i had to generate a token with:
          # curl -XPOST -d '{"type":"m.login.password","identifier":{"type": "m.id.user", "user": "@olai:olai.dev"},"password":"my-password","initial_device_display_name":"a fancy bridge"}' https://matrix.olai.dev/_matrix/client/v3/login
          # then pass this to `login-matrix` in the bot
          enable = true;
          registerToSynapse = true;
          settings = {
            homeserver = {
              address = "http://localhost:8008";
              domain = "olai.dev";
            };
            appservice = {
              id = "discord";
              public.enabled = false;
            };
            double_puppet = {
              secrets = {
                "olai.dev" = "as_token:${self.secrets.matrix.as_token}";
              };
            };
            bridge = {
              create_portals = true;
              backfill = {
                enabled = true;
                forward_limits = {
                  initial = {
                    dm = 150;
                    channel = 100;
                    thread = 50;
                  };
                  missed = {
                    dm = -1;
                    channel = 100;
                  };
                };
              };
              permissions = {
                # "*" = "relay";
                "@olai:olai.dev" = "admin";
              };
            };
          };
        };

        # Basic matrix config
        services.postgresql = {
          enable = true;
          package = pkgs.postgresql_17;

          # ensureDatabases = [ "synapse" ];
          # ensureUsers = [
          #   {
          #     name = "synapse";
          #     ensureDBOwnership = true;
          #   }
          # ];

          # Not really sure what causes this to run or not
          # also this script was generated by gemini lol
          # it might have been made overly complex because of that, for example i believe the CREATE USER block doesn't need any of the things it is wrapped in.
          # it also didn't seem to run at all. i had to do this:
          # sudo -u postgres psql -c "DROP DATABASE IF EXISTS synapse;"
          # sudo -u postgres psql -c "CREATE USER synapse;" || true
          # sudo -u postgres psql -c "CREATE DATABASE synapse WITH OWNER = synapse ENCODING = 'UTF8' LC_COLLATE = 'C' LC_CTYPE = 'C' TEMPLATE template0;"
          initialScript = pkgs.writeText "init-synapse-db.sql" ''
            DO
            $do$
            BEGIN
               IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = 'synapse') THEN
                  CREATE USER synapse;
               END IF
            END
            $do$;

            CREATE DATABASE synapse WITH OWNER = synapse ENCODING = 'UTF8' LC_COLLATE = 'C' LC_CTYPE = 'C' TEMPLATE template0;

            GRANT ALL PRIVILEGES ON DATABASE synapse TO synapse;
          '';

          authentication = lib.mkOverride 10 ''
            # TYPE  DATABASE  USER      ADDRESS       METHOD
            local   synapse   synapse                 trust
            host    synapse   synapse   127.0.0.1/32  trust
            host    synapse   synapse   ::1/128       trust

            # Fallback to default secure methods for everything else
            local   all       all                     peer
            host    all       all       127.0.0.1/32  scram-sha-256
            host    all       all       ::1/128       scram-sha-256
          '';
        };

        systemd.services.matrix-synapse.after = [ "postgresql.service" ];
        systemd.services.matrix-synapse.requires = [ "postgresql.service" ];

        services.matrix-synapse = {
          enable = true;
          settings = {
            server_name = "olai.dev";
            public_baseurl = "https://matrix.olai.dev";
            enable_registration = false;

            database = {
              name = "psycopg2";
              args = {
                database = "synapse";
                host = "/run/postgresql";
                user = "synapse";
              };
            };

            listeners = [
              {
                port = 8008;
                tls = false;
                type = "http";
                x_forwarded = true;
                bind_addresses = [ "127.0.0.1" ];
                resources = [
                  {
                    names = [
                      "client"
                      "federation"
                    ];
                    compress = false;
                  }
                ];
              }
            ];

            caches = {
              global_factor = 1.0;
            };

            registration_shared_secret = self.secrets.matrix.registration_shared_secret;

            app_service_config_files = [
              (pkgs.writeText "doublepuppet-registration.yaml" ''
                id: doublepuppet
                url: null
                as_token: "${self.secrets.matrix.as_token}"
                hs_token: "unused_hs_token"
                sender_localpart: doublepuppet
                rate_limited: false
                namespaces:
                  users:
                    - regex: '@.*:olai\.dev'
                      exclusive: false
              '')
            ];

            # Disable ratelimits for appservies (bridges)
            rc_admin_redaction = null;
            rc_message = {
              per_second = 1000;
              burst_count = 5000;
            };
            appservice_jobs_max_retries = 10;
          };

          # extraConfigFiles = [
          #   (pkgs.writeText "synapse-secret.yaml" ''
          #     registration_shared_secret: "${self.secrets.matrix.registration_shared_secret}"
          #   '')
          # ];
        };

        services.caddy.virtualHosts = {
          "matrix.olai.dev".extraConfig = ''
            reverse_proxy 127.0.0.1:8008 {
              header_up X-Forwarded-For {remote_host}
              header_up X-Forwarded-Proto {scheme}
            }

            @admin path /_synapse/admin/*
            respond @admin "Forbidden" 403
          '';

          "olai.dev".extraConfig = ''
            header /.well-known/matrix/* {
              Access-Control-Allow_Origin "*"
              Content-Type application/json
            }

            # Matrix Client Discovery Payload
            respond /.well-known/matrix/client `{"m.homeserver": {"base_url": "https://matrix.example.com"}}`

            # Matrix Federation Discovery Payload
            respond /.well-known/matrix/server `{"m.server": "matrix.example.com:443"}`
          '';
        };

        services.cloudflare-ddns.domains = [
          "matrix.olai.dev"
        ];

        settings.persist.root.directories = [
          # "/var/lib/matrix-synapse"
          config.services.matrix-synapse.dataDir
          # "/var/lib/postgresql"
          config.services.postgresql.dataDir
        ];

        nixpkgs.config.permittedInsecurePackages = [
          "olm-3.2.16"
        ];

        environment.persistence."/persist".directories = [
          {
            directory = "/var/lib/mautrix-discord";
            user = "mautrix-discord";
            group = "mautrix-discord";
            mode = "07000";
          }
          {
            directory = "/var/lib/mautrix-signal";
            user = "mautrix-signal";
            group = "mautrix-signal";
            mode = "07000";
          }
        ];
      };
    };
}
